{
  "name": "react-qr-image",
  "description": "A React component for a QR image generated from text",
  "version": "1.1.0",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "react-qr",
    "react-qr-code",
    "react",
    "qr",
    "qr-code"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.tsx --format cjs,esm --dts --target node16",
    "prepublishOnly": "npm run build",
    "types:check": "tsc --noEmit",
    "format": "pretty-quick --ignore-path .gitignore",
    "test": "npm run build && node test/render.cjs && tsc --noEmit -p test/tsconfig.package.json",
    "format:check": "prettier --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "qr-image-color": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">= 16.3"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "@types/react": "18.3.31",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
